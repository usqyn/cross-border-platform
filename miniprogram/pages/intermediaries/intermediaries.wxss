.category-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 30rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.tab {
  padding: 16rpx 32rpx;
  background: white;
  border-radius: 50rpx;
  font-size: 26rpx;
  color: #6b7280;
  flex-shrink: 0;
}

.tab.active {
  background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
  color: white;
}

.intermediary-card {
  padding: 24rpx;
}

.intermediary-header {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
}

.info {
  flex: 1;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 12rpx;
}

.meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
}

.certified-tag {
  background: #10b981;
  color: white;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.vip-tag {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: white;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-left: 8rpx;
  font-weight: 600;
}

.premium-tag {
  background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
  color: white;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-left: 8rpx;
  font-weight: 600;
}

.rating {
  color: #f59e0b;
}

.reviews {
  color: #6b7280;
}

.description {
  font-size: 26rpx;
  color: #6b7280;
  margin-top: 16rpx;
}
