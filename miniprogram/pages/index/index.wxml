<view class="container">
  <view class="language-switch">
    <picker bindchange="onLanguageChange" value="{{langIndex}}" range="{{languages}}">
      <view class="lang-btn">{{currentLang}}</view>
    </picker>
  </view>

  <!-- AI 搜索框 - 核心入口 -->
  <view class="search-section">
    <view class="search-box">
      <input 
        class="search-input" 
        placeholder="{{t('home.searchPlaceholder')}}" 
        value="{{question}}"
        bindinput="onInput"
        confirm-type="search"
        bindconfirm="onSearch"
      />
      <button class="search-btn" bindtap="onSearch" loading="{{loading}}">
        {{t('home.search')}}
      </button>
    </view>
  </view>

  <!-- 金刚区 - 垂直行业分类导航（核心导流） -->
  <view class="biz-zone-section">
    <view class="biz-zone-grid">
      <view class="biz-zone-item" bindtap="goToCategory" data-type="visa_legal">
        <view class="biz-icon-wrapper visa">
          <text class="biz-icon">🛂</text>
        </view>
        <text class="biz-title">签证法务</text>
        <text class="biz-subtitle">Visa & Legal</text>
      </view>
      <view class="biz-zone-item" bindtap="goToCategory" data-type="customs_auto">
        <view class="biz-icon-wrapper auto">
          <text class="biz-icon">🚗</text>
        </view>
        <text class="biz-title">口岸自驾</text>
        <text class="biz-subtitle">Customs & Auto</text>
      </view>
      <view class="biz-zone-item" bindtap="goToCategory" data-type="real_estate">
        <view class="biz-icon-wrapper estate">
          <text class="biz-icon">🏠</text>
        </view>
        <text class="biz-title">房产投资</text>
        <text class="biz-subtitle">Real Estate</text>
      </view>
      <view class="biz-zone-item" bindtap="goToCategory" data-type="study_life">
        <view class="biz-icon-wrapper study">
          <text class="biz-icon">🎓</text>
        </view>
        <text class="biz-title">留学生活</text>
        <text class="biz-subtitle">Study & Life</text>
      </view>
    </view>
  </view>

  <!-- AI 回答区域 -->
  <view wx:if="{{answer}}" class="answer-section card">
    <view class="answer-title">AI 回答</view>
    <view class="answer-content">{{answer}}</view>
    <!-- 导流引导文案 -->
    <view class="guide-tip">
      <text class="guide-icon">💡</text>
      <text class="guide-text">出入境口岸排队与过关情况实时变动，建议直接在上方【分类专区】寻找认证中介获取最新实况与代办服务。</text>
    </view>
  </view>

  <!-- 推荐中介列表 -->
  <view wx:if="{{intermediaries.length > 0}}" class="intermediaries-section">
    <view class="section-title">{{t('home.recommended')}}</view>
    <view class="intermediary-list">
      <view 
        wx:for="{{intermediaries}}" 
        wx:key="id" 
        class="intermediary-card card"
        bindtap="goToDetail"
        data-id="{{item.id}}"
      >
        <view class="intermediary-header">
          <image class="logo" src="{{item.logo}}" mode="aspectFill" />
          <view class="info">
            <view class="name">{{item.name}}</view>
            <view class="meta">
              <text wx:if="{{item.isCertified}}" class="certified-tag">{{t('intermediary.certified')}}</text>
              <text class="rating">★ {{item.rating}}</text>
              <text class="reviews">{{item.reviewCount}} {{t('intermediary.reviews')}}</text>
            </view>
          </view>
        </view>
        <view class="tags">
          <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</text>
        </view>
        <view class="description">{{item.description}}</view>
      </view>
    </view>
  </view>
</view>
