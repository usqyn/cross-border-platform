<view class="container">
  <view class="tabs">
    <view class="tab {{activeTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-status="all">全部</view>
    <view class="tab {{activeTab === 'pending' ? 'active' : ''}}" bindtap="switchTab" data-status="pending">待支付</view>
    <view class="tab {{activeTab === 'paid' ? 'active' : ''}}" bindtap="switchTab" data-status="paid">服务中</view>
    <view class="tab {{activeTab === 'settled' ? 'active' : ''}}" bindtap="switchTab" data-status="settled">已完成</view>
  </view>

  <view class="orders-list">
    <view wx:if="{{orders.length === 0}}" class="empty-state">
      <text class="empty-icon">💼</text>
      <text class="empty-text">暂无订单</text>
    </view>

    <view wx:for="{{orders}}" wx:key="_id" class="order-card card">
      <view class="order-header">
        <view class="order-title">
          <text class="order-type">{{getServiceTypeName(item.lead_id && item.lead_id.service_type)}}</text>
          <text class="order-status {{item.status}}">{{getStatusText(item.status)}}</text>
        </view>
        <view class="order-time">{{formatTime(item.created_at)}}</view>
      </view>
      <view class="order-info">
        <text class="order-customer">客户：{{item.user_id && item.user_id.nickname || '匿名'}}</text>
        <text class="order-amount">金额：¥{{item.amount}}</text>
      </view>
      <view class="order-footer">
        <view wx:if="{{item.status === 'paid' && (!item.proof_images || item.proof_images.length === 0)}}" class="order-actions">
          <button class="action-btn" bindtap="uploadProof" data-id="{{item._id}}">上传完成凭证</button>
        </view>
        <view wx:if="{{item.status === 'paid' && item.proof_images && item.proof_images.length > 0}}" class="order-actions">
          <text class="uploaded-text">已上传凭证，等待客户确认</text>
        </view>
      </view>
    </view>
  </view>
</view>