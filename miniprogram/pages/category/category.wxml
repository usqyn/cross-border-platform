<view class="container">
  <view wx:if="{{loading}}" class="loading-section">
    <text>加载中...</text>
  </view>

  <view wx:if="{{!loading && intermediaries.length === 0}}" class="empty-section">
    <text class="empty-icon">📭</text>
    <text class="empty-text">暂无{{categoryName}}服务商</text>
    <text class="empty-hint">稍后再来看看吧</text>
  </view>

  <view wx:if="{{!loading && intermediaries.length > 0}}" class="intermediary-list">
    <view 
      wx:for="{{intermediaries}}" 
      wx:key="id" 
      class="intermediary-card card"
      bindtap="goToDetail"
      data-id="{{item.id}}"
    >
      <view class="intermediary-header">
        <image class="logo" src="{{item.logo}}" mode="aspectFill" />
        <view class="info">
          <view class="name-row">
            <view class="name">{{item.name}}</view>
            <view wx:if="{{item.membershipLevel === 'vip'}}" class="vip-badge">
              <text class="vip-icon">👑</text>
              <text class="vip-text">VIP</text>
            </view>
            <view wx:if="{{item.membershipLevel === 'premium'}}" class="premium-badge">
              <text class="premium-text">Premium</text>
            </view>
          </view>
          <view class="meta">
            <text wx:if="{{item.isCertified}}" class="certified-tag">官方认证</text>
            <text class="rating">★ {{item.rating.toFixed(1)}}</text>
            <text class="reviews">{{item.reviewCount}}条评价</text>
          </view>
          <view class="credit-info">
            <text class="credit-label">信用分:</text>
            <text class="credit-value {{item.credit_score >= 80 ? 'good' : item.credit_score >= 60 ? 'medium' : 'low'}}">{{item.credit_score}}</text>
          </view>
        </view>
      </view>
      
      <view class="tags">
        <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</text>
      </view>
      
      <view class="description">{{item.description}}</view>
      
      <view class="contact-section">
        <view class="contact-item" wx:if="{{item.contact.phone}}">
          <text class="contact-icon">📞</text>
          <text class="contact-value">{{item.contact.phone}}</text>
        </view>
        <view class="contact-item" wx:if="{{item.contact.wechat}}">
          <text class="contact-icon">💬</text>
          <text class="contact-value">{{item.contact.wechat}}</text>
        </view>
      </view>
    </view>
  </view>
</view>