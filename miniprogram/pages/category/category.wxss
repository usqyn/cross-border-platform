.container {
  min-height: 100vh;
  background: #f3f4f6;
  padding: 30rpx;
}

.loading-section {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx;
  color: #6b7280;
  font-size: 28rpx;
}

.empty-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #111827;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #6b7280;
}

.intermediary-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.intermediary-card {
  padding: 30rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.intermediary-header {
  display: flex;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  flex-shrink: 0;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.vip-badge {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: white;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.vip-icon {
  font-size: 20rpx;
}

.vip-text {
  margin-left: 4rpx;
}

.premium-badge {
  display: inline-flex;
  background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
  color: white;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
}

.certified-tag {
  background: #10b981;
  color: white;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.rating {
  color: #f59e0b;
  font-weight: 600;
}

.reviews {
  color: #6b7280;
}

.credit-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
}

.credit-label {
  color: #6b7280;
}

.credit-value {
  font-weight: 600;
}

.credit-value.good {
  color: #10b981;
}

.credit-value.medium {
  color: #f59e0b;
}

.credit-value.low {
  color: #ef4444;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tag {
  background: #e5e7eb;
  color: #4b5563;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.description {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.contact-section {
  display: flex;
  gap: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e5e7eb;
}

.contact-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.contact-icon {
  font-size: 28rpx;
}

.contact-value {
  font-size: 26rpx;
  color: #1e3a8a;
  font-weight: 500;
}